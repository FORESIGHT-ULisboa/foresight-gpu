{
    // See https://code.visualstudio.com/docs/python/debugging
    "version": "0.2.0",
    "configurations": [
        {
            // Debug whichever .py file is active in the editor.
            "name": "Python: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "C:\\Users\\ruism\\.conda\\envs\\foresight_gpu\\python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        // {
