{
    // Use the `foresight_gpu` conda environment for everything.
    "python.defaultInterpreterPath": "C:\\Users\\ruism\\.conda\\envs\\foresight_gpu\\python.exe",

    // Debugging tests
    "debugpy.debugJustMyCode": false,

    // Test Explorer: discover and run the pytest suite in tests/.
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true
}
